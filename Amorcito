<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  
  body { 
    background: radial-gradient(circle at center, #1a001a 0%, #000 100%); 
    height: 100vh; width: 100vw;
    display: flex; justify-content: center; align-items: center; 
    perspective: 2000px; overflow: hidden;
    font-family: 'Inter', sans-serif;
  }

  .space {
    position: fixed; width: 100%; height: 100%;
    background: transparent; z-index: 1;
  }

  .master-wrapper {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    z-index: 10;
    display: flex; flex-direction: column; align-items: center;
  }

  .cube-anchor {
    width: 250px; height: 250px;
    display: flex; justify-content: center; align-items: center;
    filter: drop-shadow(0 0 50px #ff0055);
  }

  .cube { 
    width: 250px; height: 250px; 
    position: relative; 
    transform-style: preserve-3d; 
    animation: rotateInterestelar 20s infinite linear; 
  }

  .face { 
    position: absolute; 
    width: 250px; height: 250px; 
    background: rgba(10, 0, 10, 0.85); 
    border: 3px solid #ff0055; 
    display: flex; flex-direction: column;
    align-items: center; justify-content: center; 
    color: #fff; font-size: 24px; font-weight: bold;
    text-shadow: 0 0 15px #ff0055;
    box-shadow: inset 0 0 60px rgba(255, 0, 85, 0.4);
    backface-visibility: visible;
    border-radius: 5px;
  }

  .front  { transform: translateZ(125px); }
  .back   { transform: rotateY(180deg) translateZ(125px); }
  .right  { transform: rotateY(90deg) translateZ(125px); }
  .left   { transform: rotateY(-90deg) translateZ(125px); }
  .top    { transform: rotateX(90deg) translateZ(125px); }
  .bottom { transform: rotateX(-90deg) translateZ(125px); }

  .love-title {
    margin-top: 120px;
    color: #ff0055;
    font-size: 2.5rem;
    text-transform: uppercase;
    letter-spacing: 8px;
    text-shadow: 0 0 20px #ff0055;
    animation: glowText 2s infinite alternate;
  }

  @keyframes rotateInterestelar {
    0% { transform: rotateX(0deg) rotateY(0deg) rotateZ(0deg); }
    100% { transform: rotateX(360deg) rotateY(720deg) rotateZ(360deg); }
  }

  @keyframes glowText {
    from { opacity: 0.6; filter: blur(1px); }
    to { opacity: 1; filter: blur(0px); }
  }

  .heart-particle {
    position: absolute;
    font-size: 20px;
    color: #ff0055;
    pointer-events: none;
    animation: floatUp 5s linear infinite;
  }

  @keyframes floatUp {
    0% { transform: translateY(100vh) scale(0); opacity: 0; }
    50% { opacity: 0.8; }
    100% { transform: translateY(-100vh) scale(1.5) rotate(360deg); opacity: 0; }
  }
</style>
</head>
<body>
  <div class="space" id="starField"></div>

  <div class="master-wrapper">
    <div class="cube-anchor">
      <div class="cube">
        <div class="face front">Eres mi Luz 🐶</div>
        <div class="face back">Te Amo 💖</div>
        <div class="face right">Mi Mundo 🏠</div>
        <div class="face left">Siempre ✨</div>
        <div class="face top">Mi Vida 🌸</div>
        <div class="face bottom">Eternamente 💍</div>
      </div>
    </div>
    <h1 class="love-title">Tú & YO</h1>
  </div>

  <script>
    const field = document.getElementById('starField');
    function createElement(char) {
      const el = document.createElement('div');
      el.className = 'heart-particle';
      el.innerHTML = char;
      el.style.left = Math.random() * 100 + 'vw';
      el.style.animationDuration = (Math.random() * 5 + 5) + 's';
      el.style.fontSize = (Math.random() * 20 + 10) + 'px';
      field.appendChild(el);
      setTimeout(() => el.remove(), 10000);
    }

    setInterval(() => createElement('❤️'), 400);
    setInterval(() => createElement('✨'), 600);
    setInterval(() => createElement('🌸'), 800);
  </script>
</body>
</html>
